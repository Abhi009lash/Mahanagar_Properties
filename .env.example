# SMTP Serverless Configuration for Vercel & Nodemailer

# SMTP Host Server (e.g. smtp.gmail.com, smtp.resend.com, smtp.sendgrid.net, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT=465

# True for port 465, false for port 587
SMTP_SECURE=true

# Your SMTP Username / Sender Email
SMTP_USER=your-email@gmail.com

# Your SMTP Password or App Password (For Gmail, create an App Password in Google Security settings)
SMTP_PASS=your-app-password

# Email Address where contact form submissions should be delivered (Receiving Email)
RECEIVER_EMAIL=info@mahanagarproperties.com
